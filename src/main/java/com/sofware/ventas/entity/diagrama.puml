@startuml
package "com.sofware.ventas.entity" {

    class Categoria {
        - Long idCategoria
        - String nombre
        - String descripcion
    }

    class Cliente {
        - String idCliente
        - String nombre
        - String apellidos
    }

    class Producto {
        - String idProducto
        - String nombre
        - Double precio
        - Categoria categoria
        - Boolean estado
    }

    class Usuario {
        - String idUsuario
        - String username
        - String password
        - String rol
    }

    class Venta {
        - String idVenta
        - LocalDateTime fecha
        - Double total
        - String metodoPago
        - Cliente cliente
        - Usuario vendedor
        - List<DetalleVenta> detalles
    }

    class DetalleVenta {
        - String idDetalle
        - Integer cantidad
        - Double precioUnitario
        - Double subtotal
        - Producto producto
        - Venta venta
    }

    Categoria "1" <-- "*" Producto : categoria
    Cliente "0..1" <-- "*" Venta : cliente
    Usuario "1" <-- "*" Venta : vendedor
    Venta "1" *-- "*" DetalleVenta : detalles
    Producto "1" <-- "*" DetalleVenta : producto
}
@enduml